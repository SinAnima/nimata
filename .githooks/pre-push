#!/usr/bin/env bash
# Runs the full CI check suite before every push. Enable once per clone with:
#   git config core.hooksPath .githooks
# Skip for a single push with: git push --no-verify

set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

if command -v mise >/dev/null 2>&1; then
  exec mise exec -- scripts/verify.sh
fi
exec scripts/verify.sh
